{
  "name": "customer-service-platform",
  "version": "1.0.0",
  "description": "Enterprise Multi-Agent Customer Service Platform",
  "private": true,
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "setup:bge-m3": "powershell -ExecutionPolicy Bypass -File setup-bge-m3.ps1",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "server": "tsx server/index.ts",
    "quick": "npm run docker:up && npm run prisma:push && npm run prisma:seed && npm run server",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "@langchain/community": "^0.3.0",
    "@prisma/client": "^6.0.0",
    "@zilliz/milvus2-sdk-node": "^2.4.0",
    "ioredis": "^5.4.0",
    "next": "^15.0.0",
    "next-pwa": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "zod": "^3.23.0",
    "nanoid": "^5.0.0",
    "sharp": "^0.33.0",
    "openai": "^4.70.0",
    "uuid": "^10.0.0",
    "framer-motion": "^11.0.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "@tailwindcss/forms": "^0.5.0"
  }
}
