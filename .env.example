# ============================================
# Customer Service Platform - Environment Variables
# ============================================

# ---- Database (PostgreSQL with pgvector) ----
DATABASE_URL="postgresql://csp_admin:csp_secure_pwd@localhost:5432/customer_service"
POSTGRES_PASSWORD=csp_secure_pwd

# ---- Redis ----
REDIS_URL="redis://:csp_redis_pwd@localhost:6379"
REDIS_PASSWORD=csp_redis_pwd

# ---- Milvus Vector Database ----
MILVUS_ADDRESS="localhost:19530"
MILVUS_DB_NAME="customer_service"
MILVUS_COLLECTION_KNOWLEDGE="knowledge_base"
MILVUS_COLLECTION_COMPLAINTS="complaint_cases"

# ---- LLM Provider (OpenAI-compatible | DeepSeek) ----
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ---- Embedding Provider ----
# 默认: 本地 BGE-M3 (Ollama, 1024维, 中英多语言)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3
# 备选: OpenAI embedding (取消注释下面三行，注释上面三行即可切换)
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-openai-api-key
# EMBEDDING_MODEL=text-embedding-3-large

# ---- CV Model (Adapter Pattern) ----
CV_MODEL_TYPE=openai                    # openai | claude | local
CV_MODEL_ENDPOINT=https://api.deepseek.com/v1
CV_MODEL_API_KEY=sk-your-deepseek-api-key
CV_MODEL_NAME=deepseek-chat

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000
APP_SECRET=your-app-secret-change-in-production

# ---- Authentication ----
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=24h
SESSION_TTL=86400

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---- File Upload ----
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- LangSmith Tracing (optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=customer-service

# ---- MCP (Model Context Protocol) ----
MCP_ENABLED=false
MCP_SERVER_PORT=3001
