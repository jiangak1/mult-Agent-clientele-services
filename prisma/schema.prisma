generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ============================================
// Tenant (Multi-Tenancy)
// ============================================
model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  plan        String   @default("basic") @db.VarChar(50)
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        CustomerUser[]
  conversations Conversation[]
  knowledgeBases KnowledgeBase[]
  complaintCases ComplaintCase[]
  agentConfigs AgentConfig[]
  products     Product[]
  auditLogs    AuditLog[]
  orders        OrderCache[]
  cases         Case[]

  @@index([slug])
}

// ============================================
// Customer Users (per tenant)
// ============================================
model CustomerUser {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  externalId  String?  @db.VarChar(255)
  name        String   @db.VarChar(255)
  email       String?  @db.VarChar(320)
  phone       String?  @db.VarChar(50)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  memories     UserMemory[]

  @@unique([tenantId, externalId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

// ============================================
// Conversations
// ============================================
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  intent    String?  @db.VarChar(100)
  subIntent String?  @db.VarChar(100)
  status    String   @default("active") @db.VarChar(50)
  channel   String   @default("web") @db.VarChar(50)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  user    CustomerUser @relation(fields: [userId], references: [id])
  messages Message[]
  orderLinks ConversationOrder[]

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ============================================
// Messages
// ============================================
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String   @db.VarChar(50) // user | assistant | system | agent
  agentType      String?  @db.VarChar(100) // intent_classifier | presale | aftersale | supervisor
  content        String   @db.Text
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

// ============================================
// Knowledge Base (per tenant, vector-enabled)
// ============================================
model KnowledgeBase {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  title      String   @db.VarChar(500)
  content    String   @db.Text
  category   String?  @db.VarChar(200)
  embedding  Unsupported("vector(1024)")?
  source     String?  @db.VarChar(500)
  metadata   Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category])
}

// ============================================
// Complaint Cases (per tenant, vector-enabled)
// ============================================
model ComplaintCase {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String   @db.VarChar(500)
  description String   @db.Text
  category    String?  @db.VarChar(200)
  severity    String   @default("medium") @db.VarChar(50)
  resolution  String?  @db.Text
  embedding   Unsupported("vector(1024)")?
  imageUrls   String[] @default([])
  metadata    Json     @default("{}")
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, severity])
}

// ============================================
// Case Engine — knowledge base for resolved support cases
// Uses pgvector for similarity search (NO Milvus dependency)
// ============================================
model Case {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  productId         String?  @db.Uuid
  issue             String   @db.Text
  solution          String   @db.Text
  category          String?  @db.VarChar(200)
  severity          String   @default("medium") @db.VarChar(50)
  status            String   @default("resolved") @db.VarChar(50)
  successRate       Float    @default(0)
  satisfactionScore Float    @default(0)
  resolutionCount   Int      @default(0)
  feedbackCount     Int      @default(0)
  embedding         Unsupported("vector(1024)")?
  ticketId          String?  @db.VarChar(100)
  tags              String[] @default([])
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([tenantId, successRate])
  @@index([tenantId, productId])
}

// ============================================
// Product Inventory (per tenant)
// ============================================
model Product {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  sku       String   @db.VarChar(100)
  name      String   @db.VarChar(500)
  description String? @db.Text
  price     Decimal  @db.Decimal(12, 2)
  stock     Int      @default(0)
  category  String?  @db.VarChar(200)
  imageUrls  String[] @default([])
  attributes Json    @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  skuMappings PlatformSkuMapping[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
}

// ============================================
// User Long-Term Memory
// ============================================
model UserMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  key       String   @db.VarChar(500)
  value     Json
  ttl       Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user CustomerUser @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

// ============================================
// Agent Configuration (per tenant)
// ============================================
model AgentConfig {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  agentName String @db.VarChar(100)
  config   Json   @default("{}")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, agentName])
}

// ============================================
// Order Cache — unified platform-independent order storage
// ============================================
model OrderCache {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  platform          String   @db.VarChar(50)
  platformOrderId   String   @db.VarChar(100)
  parentOrderId     String?  @db.VarChar(100)
  status            String   @db.VarChar(50)
  platformStatus    String   @db.VarChar(100)
  totalAmount       Decimal  @db.Decimal(12, 2)
  shippingFee       Decimal  @db.Decimal(10, 2) @default(0)
  discountAmount    Decimal  @db.Decimal(10, 2) @default(0)
  originalAmount    Decimal  @db.Decimal(12, 2) @default(0)
  buyerNick         String?  @db.VarChar(255)
  buyerNote         String?  @db.Text
  receiverName      String?  @db.VarChar(100)
  receiverPhoneHash String?  @db.VarChar(255)
  receiverPhoneLast4 String? @db.VarChar(4)
  receiverProvince  String?  @db.VarChar(100)
  receiverCity      String?  @db.VarChar(100)
  receiverDistrict  String?  @db.VarChar(100)
  receiverAddress   String?  @db.Text
  orderCreatedAt    DateTime
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  customerUserId    String?  @db.Uuid
  platformData      Json     @default("{}")
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  items           OrderItemCache[]
  afterSales      AfterSaleCache[]
  conversationLinks ConversationOrder[]

  @@unique([tenantId, platform, platformOrderId])
  @@index([tenantId, status])
  @@index([tenantId, orderCreatedAt])
  @@index([tenantId, receiverPhoneHash, receiverPhoneLast4])
  @@index([tenantId, customerUserId])
}

// ============================================
// Order Item Cache — line items for each order
// ============================================
model OrderItemCache {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  platformSkuId  String   @db.VarChar(200)
  platformItemId String   @db.VarChar(100)
  title          String   @db.VarChar(500)
  price          Decimal  @db.Decimal(12, 2)
  quantity       Int
  totalAmount    Decimal  @db.Decimal(12, 2)
  skuAttributes  Json     @default("{}")
  imageUrl       String?  @db.VarChar(1000)
  outerSkuId     String?  @db.VarChar(100)
  productId      String?  @db.Uuid

  order          OrderCache @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([outerSkuId])
  @@index([productId])
}

// ============================================
// After-Sale Cache — refund/return/exchange records
// ============================================
model AfterSaleCache {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  orderId             String   @db.Uuid
  platform            String   @db.VarChar(50)
  platformAfterSaleId String   @db.VarChar(100)
  type                String   @db.VarChar(50)
  status              String   @db.VarChar(50)
  reason              String?  @db.Text
  amount              Decimal  @db.Decimal(12, 2)
  description         String?  @db.Text
  platformData        Json     @default("{}")
  afterSaleCreatedAt  DateTime
  resolvedAt          DateTime?
  lastSyncedAt        DateTime @default(now())

  order               OrderCache @relation(fields: [orderId], references: [id])

  @@unique([tenantId, platform, platformAfterSaleId])
  @@index([orderId])
  @@index([tenantId, status])
}

// ============================================
// Conversation-Order Link — join table
// ============================================
model ConversationOrder {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  orderId        String   @db.Uuid

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  order          OrderCache   @relation(fields: [orderId], references: [id])

  @@unique([conversationId, orderId])
}

// ============================================
// Platform SKU Mapping — maps external SKU to local Product
// ============================================
model PlatformSkuMapping {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  platform      String   @db.VarChar(50)
  platformSkuId String   @db.VarChar(200)
  productId     String   @db.Uuid
  createdAt     DateTime @default(now())

  product       Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, platform, platformSkuId])
  @@index([productId])
}

// ============================================
// Audit Log
// ============================================
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  action    String   @db.VarChar(200)
  resource  String   @db.VarChar(200)
  resourceId String? @db.VarChar(100)
  details   Json     @default("{}")
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}
